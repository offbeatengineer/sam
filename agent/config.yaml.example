# Sam configuration — ~/.sam/config.yaml
# This file is auto-created on first run at ~/.sam/config.yaml

discord:
  # Bot token (can also be set via DISCORD_TOKEN env var)
  # token: "your-bot-token"

  # Restrict the bot to specific channels (optional).
  # If omitted, the bot responds in all channels where it is mentioned.
  # allowedChannelIds:
  #   - "1234567890123456789"

model:
  provider: anthropic
  id: claude-sonnet-4-20250514
  thinking: "off"
  # apiKey: "sk-..."  # can also be set via MODEL_API_KEY env var

# workspace: ~/.sam/workspace
# sessions: ~/.sam/sessions

# prompts:
#   system: ~/.sam/prompts/system.md
#   pulse: ~/.sam/prompts/pulse.md

# pulse:
#   enabled: true
#   every: "30m"
#   delivery:
#     channel: discord
#     targetChannelId: "1234567890123456789"
#   activeHours:
#     start: "08:00"
#     end: "22:00"
#     timezone: "America/Los_Angeles"

# app:
#   enabled: true
#   port: 9222
#   host: 127.0.0.1
#   apiKey: ""  # or set SAM_APP_API_KEY env var — required for remote access

# skills: ~/.sam/skills

# Browser automation (optional — requires playwright-cli):
#   npm install -g @playwright/cli
#   playwright-cli install
#   cd ~/.sam/skills && playwright-cli install --skills
