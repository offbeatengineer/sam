# Sam configuration — ~/.sam/config.yaml
# This file is auto-created on first run at ~/.sam/config.yaml

discord:
  # Bot token (can also be set via DISCORD_TOKEN env var)
  # token: "your-bot-token"

  # Restrict the bot to specific channels (optional).
  # If omitted, the bot responds in all channels where it is mentioned.
  # allowedChannelIds:
  #   - "1234567890123456789"

model:
  provider: anthropic
  id: claude-sonnet-4-20250514
  thinking: "off"
  # apiKey: "sk-..."  # can also be set via MODEL_API_KEY env var

# workspace: ~/.sam/workspace
# sessions: ~/.sam/sessions

# prompts:
#   system: ~/.sam/prompts/system.md
#   pulse: ~/.sam/prompts/pulse.md

# pulse:
#   enabled: true
#   every: "30m"
#   delivery:
#     channel: discord
#     targetChannelId: "1234567890123456789"
#   activeHours:
#     start: "08:00"
#     end: "22:00"
#     timezone: "America/Los_Angeles"

# app:
#   enabled: true
#   port: 9222
#   host: 127.0.0.1
#   apiKey: ""  # or set SAM_APP_API_KEY env var — required for remote access

# skills: ~/.sam/skills

# Long-term memory (local LanceDB + local embeddings). On by default.
# memory:
#   enabled: true
#   storagePath: ~/.sam/memory
#   modelsPath: ~/.sam/models
#
#   # Automatic memory: recall before every turn, save / replace / forget after
#   # it, instead of relying on the model to call memory tools. Opt-in.
#   # PRIVACY: when enabled, the text of your active memories and the last few
#   # messages are sent to api.typesafe.ai on every turn. See the README.
#   typesafe:
#     enabled: true
#     # apiKey: ""          # or set TYPESAFE_API_KEY in agent/.env
#     # model: jev-1.13.0   # pinned; thresholds are calibrated per version
#     # recall: true        # automatic recall before each turn
#     # write: true         # automatic save/replace/forget; false keeps the write tools
#     # timeoutMs: 2500     # a turn never waits longer than this for recall
#     # knowledge: true     # also keep reference notes of what Sam explained or looked up (needs write)
#     # knowledgeTools: all # or a list, e.g. [web_fetch, web_search], of tools whose results the writer may read
#     # knowledgeMaterialTokens: 100000  # budget for the tool results handed to the writer model
#
#   # Model that writes memory text on the pi backend. The agent-sdk backend
#   # uses Claude Haiku through your subscription instead.
#   writer:
#     provider: deepseek
#     id: deepseek-v4-flash

# Audio transcription via vocal (https://github.com/offbeatengineer/vocal):
# When enabled, Sam runs `brew install ffmpeg`, `brew install offbeatengineer/tap/vocal`,
# and `vocal download asr` automatically in the background on startup (Homebrew
# is required and assumed to be on PATH). Setup never blocks the agent —
# non-audio input is served normally throughout. Audio messages received before
# setup completes get a "starting up" reply.
# transcription:
#   enabled: true
#   model: small        # "small" (0.6B, ~1.8 GB) or "large" (1.7B, ~4.4 GB)
#   # language: en      # optional ISO code hint; omit for auto-detect
#   # threads: 8        # vocal default is 4
#   # binaryPath: /opt/homebrew/bin/vocal  # override vocal binary lookup
#   # modelDir: ~/.vocal/models            # override --model-dir
#   # timeoutMs: 120000

# Browser automation (optional — requires playwright-cli):
#   npm install -g @playwright/cli
#   playwright-cli install
#   cd ~/.sam/skills && playwright-cli install --skills
