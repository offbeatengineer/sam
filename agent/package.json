{
  "name": "sam-ai",
  "version": "0.1.0",
  "description": "A lightweight AI assistant built on pi-coding-agent",
  "type": "module",
  "bin": {
    "sam": "src/index.ts"
  },
  "files": [
    "src",
    "prompts",
    "skills",
    "config.yaml.example",
    "README.md"
  ],
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "watchexec -w src -w prompts -r -- bun --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "^0.60.0",
    "@mariozechner/pi-coding-agent": "^0.60.0",
    "chokidar": "^4.0.0",
    "discord.js": "^14.25.1",
    "hono": "^4.0.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "ai",
    "assistant",
    "discord",
    "claude",
    "pi-coding-agent"
  ],
  "license": "MIT"
}
