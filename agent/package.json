{
  "name": "sam-ai",
  "version": "0.1.0",
  "description": "A lightweight AI assistant built on pi-coding-agent",
  "type": "module",
  "bin": {
    "sam": "src/index.ts"
  },
  "files": [
    "src",
    "prompts",
    "skills",
    "config.yaml.example",
    "README.md"
  ],
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "watchexec -w src -w prompts -r -- bun --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.198",
    "@earendil-works/pi-ai": "^0.80.3",
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "chokidar": "^4.0.3",
    "discord.js": "^14.26.4",
    "hono": "^4.12.27",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "ai",
    "assistant",
    "discord",
    "claude",
    "pi-coding-agent"
  ],
  "license": "MIT"
}
