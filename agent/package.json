{
  "name": "sam-ai",
  "version": "0.1.0",
  "description": "A lightweight AI assistant built on pi-coding-agent",
  "type": "module",
  "bin": {
    "sam": "dist/index.js"
  },
  "files": [
    "dist",
    "prompts",
    "skills",
    "config.yaml.example",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx --watch --env-file=.env src/index.ts",
    "prepublishOnly": "tsc"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "^0.52.12",
    "@mariozechner/pi-coding-agent": "^0.52.12",
    "@mozilla/readability": "^0.6.0",
    "chokidar": "^4.0.0",
    "discord.js": "^14.25.1",
    "linkedom": "^0.18.12",
    "ws": "^8.18.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "ai",
    "assistant",
    "discord",
    "claude",
    "pi-coding-agent"
  ],
  "license": "MIT",
  "overrides": {
    "undici": "^6.23.0"
  }
}
